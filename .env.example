# ============================================================
# CRT Password Manager — variáveis de ambiente (backend)
# Copie este arquivo para backend/.env e preencha com valores
# reais. NUNCA versione o .env real no Git.
# ============================================================

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/crt_password_manager?schema=public"

# Porta da API
PORT=3000
NODE_ENV=development

# JWT
# Gere valores aleatórios fortes, ex: openssl rand -base64 64
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Chave de criptografia simétrica (AES-256-GCM) usada para
# cifrar/decifrar os segredos armazenados no cofre.
# Deve ter 32 bytes. Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Frontend (usado para configurar CORS)
FRONTEND_URL=http://localhost:5173

# Proteção do comando `npm run create-admin` em produção.
# Só é necessário definir/usar quando NODE_ENV=production.
ALLOW_CREATE_ADMIN=false
