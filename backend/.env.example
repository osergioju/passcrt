# Ver o .env.example na raiz do projeto para a lista completa e comentada.
# Copie este arquivo para .env dentro de backend/ e preencha os valores.
DATABASE_URL="postgresql://user:password@localhost:5432/crt_password_manager?schema=public"
PORT=3000
NODE_ENV=development
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
ALLOW_CREATE_ADMIN=false
# Só mude se a API for servida atrás de um subpath (proxy reverso em
# /algo/api/...) — nesse caso, use "/algo/api/auth".
COOKIE_PATH=/api/auth
