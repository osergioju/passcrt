[Unit]
Description=CRT Password Manager - API backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=crtapp
Group=crtapp
WorkingDirectory=/opt/crt-password-manager/backend
EnvironmentFile=/opt/crt-password-manager/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

# Hardening básico do serviço (opcional, mas recomendado numa VPS
# compartilhada). Ajuste ReadWritePaths se o app escrever em outro
# lugar além do log padrão via stdout/journald.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crt-password-manager/backend

[Install]
WantedBy=multi-user.target
